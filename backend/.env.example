DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<dbname>
JWT_SECRET_KEY=<your-secret-key>
FRONTEND_ORIGINS=https://your-project.vercel.app
# Add comma-separated origins if needed:
# FRONTEND_ORIGINS=https://your-project.vercel.app,https://www.example.com

# Flask-Mail (Gmail SMTP)
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=<16-char-gmail-app-password>
# Optional overrides (defaults shown)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587

# Public URL of the backend (used in verification emails)
# On EC2: http://<your-ec2-public-ip-or-domain>:5000
# On Render: https://<your-render-service>.onrender.com
BASE_URL=http://localhost:8080
