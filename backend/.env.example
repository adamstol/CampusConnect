DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<dbname>
JWT_SECRET_KEY=<your-secret-key>
FRONTEND_ORIGINS=https://your-project.vercel.app
# Add comma-separated origins if needed:
# FRONTEND_ORIGINS=https://your-project.vercel.app,https://www.example.com

# Flask-Mail (IONOS or Gmail SMTP)
MAIL_USERNAME=no-reply@yourdomain.com
MAIL_PASSWORD=<mailbox-password>
MAIL_SERVER=smtp.ionos.com
MAIL_PORT=587
# For Gmail: MAIL_SERVER=smtp.gmail.com  MAIL_PASSWORD=<16-char-app-password>

# Public URL of the backend (used in verification emails)
# On EC2: http://<your-ec2-public-ip-or-domain>:5000
BASE_URL=http://localhost:8080

# AWS S3 — for club logo and event image uploads
AWS_ACCESS_KEY_ID=<your-iam-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-iam-secret-access-key>
AWS_S3_BUCKET=<your-bucket-name>
AWS_S3_REGION=<your-bucket-region>   # e.g. us-east-1
